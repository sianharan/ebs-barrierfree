# API 키 템플릿 — 이 파일을 .env 로 복사한 뒤 실제 키를 채운다.
#   cp .env.example .env
# .env 는 .gitignore 로 제외된다(커밋 금지).
#
# 로컬 전처리(scripts/)에서 사용. 배포 런타임(/api)은 Vercel 대시보드의
# Environment Variables 에 동일 키를 등록한다.

# Claude — STT 교정·번역·어휘·Vision (scripts/), 검색 폴백 (/api)
ANTHROPIC_API_KEY=

# OpenAI — Whisper STT·임베딩 (scripts/), 질의 임베딩·TTS 폴백 (/api)
OPENAI_API_KEY=
