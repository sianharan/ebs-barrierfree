# API 키 템플릿 — 이 파일을 .env 로 복사한 뒤 실제 키를 채운다.
#   cp .env.example .env
# .env 는 .gitignore 로 제외된다(커밋 금지).
#
# 로컬 전처리(scripts/)에서 사용. 배포 런타임(/api)은 Vercel 대시보드의
# Environment Variables 에 동일 키를 등록한다.

# Claude — STT 교정·번역·어휘·Vision (scripts/), 검색 폴백 (/api)
ANTHROPIC_API_KEY=

# OpenAI — Whisper STT·임베딩 (scripts/), 질의 임베딩·읽어주기 TTS (/api/tts)
OPENAI_API_KEY=

# (선택) 읽어주기 TTS 모델·보이스. 미설정 시 기본값 사용.
#   OPENAI_TTS_MODEL: gpt-4o-mini-tts(기본, 언어 지시 지원) 또는 tts-1
#   OPENAI_TTS_VOICE: alloy(기본)·echo·fable·onyx·nova·shimmer 등
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
